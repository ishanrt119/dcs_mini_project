# RailSync - Distributed Railway Intelligence Platform Configuration
# Permanent Local Offline Demo Mode (External Railway APIs Disabled)

DEMO_MODE=true
LIVE_API_ENABLED=false

# Offline Mock Demonstration Settings
MOCK_PROVIDER_ENABLED=true
TIMEZONE=Asia/Kolkata

# Distributed Service Ports
GATEWAY_PORT=4000
TRAIN_SERVICE_PORT=4001
JOURNEY_SERVICE_PORT=4002
RESERVATION_SERVICE_PORT=4003
ANALYTICS_SERVICE_PORT=4004
CLIENT_PORT=5173

# Local SQLite Persistence
SQLITE_DB_PATH=./data/db/railsync.db
