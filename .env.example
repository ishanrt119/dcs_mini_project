# RailSync - Distributed Railway Intelligence Platform Configuration

# Operational Modes (Strict Quota Protection)
# DEMO_MODE: true uses locally stored realistic mock fixtures and simulated models
DEMO_MODE=true

# LIVE_API_ENABLED: Must be explicitly true to allow outbound calls to api.railradar.in
# Even if an API key is present, calls are rejected if this is false.
LIVE_API_ENABLED=false

# RailRadar API Credentials
RAILRADAR_API_KEY=
RAILRADAR_BASE_URL=https://api.railradar.in

# API Request Budget Manager
RAILRADAR_MONTHLY_LIMIT=100
RAILRADAR_INTERNAL_BUDGET=80
RAILRADAR_TIMEZONE=Asia/Kolkata

# Distributed Service Ports
GATEWAY_PORT=4000
TRAIN_SERVICE_PORT=4001
JOURNEY_SERVICE_PORT=4002
RESERVATION_SERVICE_PORT=4003
ANALYTICS_SERVICE_PORT=4004
CLIENT_PORT=5173

# Persistence
SQLITE_DB_PATH=./data/db/railsync.db
